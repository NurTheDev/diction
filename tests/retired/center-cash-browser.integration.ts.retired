// @ts-nocheck -- Synthetic browser test against an isolated replica set.
import {MongoMemoryReplSet} from 'mongodb-memory-server';
import mongoose from 'mongoose';
import bcrypt from 'bcryptjs';
import {spawn} from 'node:child_process';
import {createServer} from 'node:net';
import {randomBytes} from 'node:crypto';
import {mkdir} from 'node:fs/promises';
import {chromium} from 'playwright';
import assert from 'node:assert/strict';
import {User} from '../src/models/User';
import {CenterClassGroup,CenterStudent,CenterPayment,CenterCashBatch,CenterActivityLog} from '../src/models/CenterRecords';
async function port(){return new Promise(resolve=>{const s=createServer().listen(0,'127.0.0.1',()=>{const a=s.address();s.close(()=>resolve(a.port))})})}
async function run(){const out='/home/user/.cache/center-cash-review';await mkdir(out,{recursive:true});const mongo=await MongoMemoryReplSet.create({replSet:{count:1}});await mongoose.connect(mongo.getUri(),{dbName:'dictioncoaching'});const pass=randomBytes(20).toString('base64url'),hash=await bcrypt.hash(pass,12);for(const role of ['admin','content_editor'])await User.create({name:`Synthetic ${role}`,email:`cash-${role}@example.test`,passwordHash:hash,role,active:true});const group=await CenterClassGroup.create({name:{bn:'ক্লাস ৭'},academicYear:2026}),student=await CenterStudent.create({studentId:'SYNTHETIC-CASH',name:{bn:'নমুনা শিক্ষার্থী'},classGroup:group._id,guardianName:'নমুনা অভিভাবক',guardianPhone:'01712345678',admissionDate:'2026-01-01',startMonth:{year:2026,month:1},feeHistory:[{effectiveFrom:{year:2026,month:1},amount:1000}]});const p=await port(),origin=`http://127.0.0.1:${p}`;let log='';const server=spawn(process.cwd()+'/node_modules/.bin/next',['start','-H','127.0.0.1','-p',String(p)],{cwd:process.cwd(),env:{...process.env,MONGODB_URI:mongo.getUri(),NEXTAUTH_SECRET:randomBytes(32).toString('base64'),NEXTAUTH_URL:origin,AUTH_URL:origin,AUTH_TRUST_HOST:'true',DATA_COLLECTION_ENABLED:'true',CENTER_CASH_WRITE_ENABLED:'true'},stdio:['ignore','pipe','pipe']});const browser=await chromium.launch();try{await new Promise((resolve,reject)=>{const timer=setTimeout(()=>reject(Error(log)),90000);const on=b=>{log+=b.toString();if(log.includes('Ready in')){clearTimeout(timer);resolve()}};server.stdout.on('data',on);server.stderr.on('data',on);server.once('exit',()=>reject(Error(log)))});async function login(role){const c=await browser.newContext({viewport:{width:360,height:900}}),csrf=await (await c.request.get(origin+'/api/auth/csrf')).json();await c.request.post(origin+'/api/auth/callback/credentials',{headers:{origin,'content-type':'application/x-www-form-urlencoded'},form:{csrfToken:csrf.csrfToken,identifier:`cash-${role}@example.test`,password:pass,callbackUrl:origin+'/bn/admin'}});return c}const c=await login('admin'),page=await c.newPage(),errors=[];await page.addInitScript(()=>{const original=window.fetch;window.fetch=function(input,init){if((window as any).__capture&&init?.method==='POST'){(window as any).__capture=false;(window as any).__replay=()=>original(input,init)}return original(input,init)}});page.on('pageerror',e=>errors.push(e.message));await page.goto(origin+`/bn/admin/students/${student._id}/collect`,{waitUntil:'networkidle'});const form=page.locator('.center-cash-form');await form.locator('[name=receiptNo]').fill('১৭১১');await form.locator('[name=paidOn]').fill('2026-01-02');await form.locator('[name=month-1]').fill('১০০০');await form.locator('[name=month-2]').fill('৫০০');await form.locator('[name=admission]').fill('৫০০');await form.getByText('মোট নগদ: ২০০০ টাকা').waitFor();assert.equal(await CenterPayment.countDocuments({}),0);for(const width of [360,768,1440]){await page.setViewportSize({width,height:900});const m=await page.evaluate(()=>({scroll:document.documentElement.scrollWidth,client:document.documentElement.clientWidth}));assert(m.scroll<=m.client+1,`overflow ${width}`);if(width!==768)await form.screenshot({path:`${out}/cash-${width}.png`})}await form.locator('[name=confirm]').check();await page.evaluate(()=>{(window as any).__capture=true});await form.getByRole('button',{name:'নগদ সংরক্ষণ করুন'}).click();await form.getByText('নগদ লেনদেন সংরক্ষণ হয়েছে।',{exact:false}).waitFor();assert.equal(await CenterPayment.countDocuments({status:'valid'}),3);assert.equal(await CenterCashBatch.countDocuments({}),1);assert.equal((await CenterStudent.findById(student._id)).revision,1);const second=await c.newPage();await second.goto(origin+`/bn/admin/students/${student._id}/collect`,{waitUntil:'networkidle'});const voidBox=second.locator('details').filter({hasText:'লেনদেন বাতিল করুন'}).first();await voidBox.locator('summary').click();await voidBox.getByLabel('কারণ').fill('নমুনা ভুল');await voidBox.getByLabel('বাতিল নিশ্চিত করছি').check();await voidBox.getByRole('button',{name:'বাতিল সংরক্ষণ'}).click();await second.locator('table tbody').getByText('বাতিল',{exact:true}).first().waitFor();assert.equal(await CenterPayment.countDocuments({status:'void'}),3);assert.equal(await CenterPayment.countDocuments({}),3);const replay=await page.evaluate(async()=>{const fn=(window as any).__replay;if(!fn)throw Error('missing replay');return (await fn()).text()});assert(replay.includes('REQUEST_ALREADY_VOID'));assert.equal(await CenterPayment.countDocuments({status:'valid'}),0);assert.equal(await CenterActivityLog.countDocuments({action:'cash.void'}),1);const ec=await login('content_editor'),ep=await ec.newPage();await ep.goto(origin+`/bn/admin/students/${student._id}/collect`,{waitUntil:'networkidle'});assert(!ep.url().includes('/students/'));assert.deepEqual(errors,[]);await ec.close();await c.close();console.log('Cash browser: cash total, explicit confirmation, role guard, atomic entry, void and replay rejection passed.')}finally{server.kill('SIGTERM');await browser.close();await mongoose.disconnect();await mongo.stop()}}
run().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)});
