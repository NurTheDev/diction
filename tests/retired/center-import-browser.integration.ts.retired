// @ts-nocheck -- Synthetic browser integration test.
import {MongoMemoryReplSet} from 'mongodb-memory-server';
import mongoose from 'mongoose';
import bcrypt from 'bcryptjs';
import {spawn} from 'node:child_process';
import {createServer} from 'node:net';
import {randomBytes} from 'node:crypto';
import {mkdir} from 'node:fs/promises';
import {chromium} from 'playwright';
import assert from 'node:assert/strict';
import {User} from '../src/models/User';
import {CenterStudent,CenterPayment,CenterClassGroup,CenterActivityLog} from '../src/models/CenterRecords';
async function port(){return new Promise(resolve=>{const s=createServer().listen(0,'127.0.0.1',()=>{const a=s.address();s.close(()=>resolve(a.port))})})}
async function run(){const out='/home/user/.cache/center-import-review';await mkdir(out,{recursive:true});const shared=process.env.TEST_ORIGIN?process.env.TEST_MONGO_URI:null;const mongo=shared?{getUri:()=>shared,stop:async()=>{}}:await MongoMemoryReplSet.create({replSet:{count:1}});await mongoose.connect(mongo.getUri(),{dbName:'dictioncoaching'});if(shared){for(const c of await mongoose.connection.db.listCollections().toArray()){await mongoose.connection.db.collection(c.name).deleteMany({}).catch(()=>{})}}await mongoose.connection.collection('ratelimits').deleteMany({}).catch(()=>{});await mongoose.connection.collection('ratelimits').deleteMany({}).catch(()=>{});await mongoose.connection.collection('ratelimits').deleteMany({}).catch(()=>{});const pass=randomBytes(20).toString('base64url'),hash=await bcrypt.hash(pass,12);for(const role of ['admin','content_editor'])await User.create({name:`Synthetic ${role}`,email:`import-${role}@example.test`,passwordHash:hash,role,active:true});const group=await CenterClassGroup.create({name:{bn:'ক্লাস ৭',en:'Class 7'},academicYear:2026,shift:'All'});const candidate=await CenterStudent.create({studentId:'SYNTHETIC-1',name:{bn:'নমুনা ক',en:'Sample A'},classGroup:group._id,guardianName:'নমুনা অভিভাবক',guardianPhone:'01711000001',admissionDate:'2026-01-01',startMonth:{year:2026,month:1},feeHistory:[{effectiveFrom:{year:2026,month:1},amount:2000}]});const origin=process.env.TEST_ORIGIN||'http://127.0.0.1:3100';const server={kill(){}};const browser=await chromium.launch();try{{let ready=false;for(let i=0;i<60&&!ready;i++){try{const r=await fetch(origin+'/api/auth/csrf');ready=r.ok}catch{}if(!ready)await new Promise(r=>setTimeout(r,1000))}if(!ready)throw Error('dev server not reachable at '+origin)}async function login(role){const c=await browser.newContext({viewport:{width:360,height:900}}),csrf=await (await c.request.get(origin+'/api/auth/csrf')).json();await c.request.post(origin+'/api/auth/callback/credentials',{timeout:180000,headers:{origin,'content-type':'application/x-www-form-urlencoded'},form:{csrfToken:csrf.csrfToken,identifier:`import-${role}@example.test`,password:pass,callbackUrl:origin+'/bn/admin'}});return c}const c=await login('admin'),page=await c.newPage(),errors=[];page.on('pageerror',e=>errors.push(e.message));await page.goto(origin+'/bn/admin/students/import',{waitUntil:'domcontentloaded',timeout:180000});await page.locator('input[name=file]').setInputFiles('tests/fixtures/synthetic-class-7.xlsx');await page.locator('input[name=sheet]').fill('Class 7');await page.locator('select[name=classId]').selectOption(String(group._id));await page.getByRole('button',{name:'প্রিভিউ দেখুন'}).click();await page.getByText('শিক্ষার্থী জোড়া: 8').waitFor();assert.equal(await page.locator('section.center-import-preview details.center-preview-row').count(),8);await page.locator('section.center-import-preview details.center-preview-row').first().locator('summary').click();await page.getByText('SYNTHETIC-1',{exact:false}).waitFor();const decision=page.locator('section.center-import-preview details.center-preview-row').first().locator('.center-import-decisions select').first();await decision.selectOption('none');assert.equal(await decision.inputValue(),'none');const [download]=await Promise.all([page.waitForEvent('download'),page.getByRole('button',{name:'পর্যালোচনার খসড়া ডাউনলোড'}).click()]);const draftPath=out+'/review.json';await download.saveAs(draftPath);await decision.selectOption('inspect');await page.locator('.center-import-preview .center-draft-tools input[type=file]').setInputFiles(draftPath);await page.getByText('খসড়া লোড হয়েছে।').waitFor();assert.equal(await decision.inputValue(),'none');await page.locator('.center-import-preview .center-draft-tools input[type=file]').setInputFiles({name:'bad.json',mimeType:'application/json',buffer:Buffer.from(JSON.stringify({version:1,fingerprint:'bad',decisions:{}}))});await page.getByText('খসড়াটি এই প্রিভিউর সঙ্গে মেলেনি বা অবৈধ।').waitFor();assert.equal(await decision.inputValue(),'none');await page.locator('.center-import-preview .center-draft-tools input[type=file]').setInputFiles(draftPath);await page.getByText('খসড়া লোড হয়েছে।').waitFor();await page.locator('section.center-import-preview details.center-preview-row').nth(2).locator('summary').click();await page.getByText('লাল সারি — অর্থ অজানা').waitFor();await page.locator('section.center-import-preview details.center-preview-row').nth(5).locator('summary').click();assert.equal(await CenterStudent.countDocuments({}),1);assert.equal((await CenterStudent.findById(candidate._id).lean()).name.bn,'নমুনা ক');assert.equal(await CenterActivityLog.countDocuments({}),0);assert.equal(await CenterPayment.countDocuments({}),0);for(const width of [360,768,1440]){await page.setViewportSize({width,height:900});const m=await page.evaluate(()=>({scroll:document.documentElement.scrollWidth,client:document.documentElement.clientWidth}));assert(m.scroll<=m.client+1,`overflow ${width} ${JSON.stringify(m)}`);if(width!==768){await page.screenshot({path:`${out}/preview-${width}.png`,fullPage:true});await page.locator('section.center-import-preview details.center-preview-row').first().screenshot({path:`${out}/decision-${width}.png`})}}const commit=page.locator('.center-commit'),studentB=commit.locator('details.center-preview-row').filter({hasText:'Sample B'});await studentB.locator('summary').click();await studentB.getByLabel('এই শিক্ষার্থী ইমপোর্টে অন্তর্ভুক্ত করুন').check();await studentB.getByLabel('অভিভাবকের নাম *').fill('নমুনা অভিভাবক');await studentB.getByLabel('ভর্তির তারিখ *').fill('2026-01-01');await commit.getByLabel('ডিফল্ট মাসিক ফি (টাকা)').fill('2500');await commit.getByRole('button',{name:'নির্বাচিতদের জন্য ডিফল্ট বসান'}).click();await studentB.getByLabel('আমি এই শিক্ষার্থীর নাম, ফোন, তারিখ, প্রথম মাস ও সম্পূর্ণ ফি ইতিহাস যাচাই করেছি।').check();await commit.getByRole('button',{name:'নিরাপদ চূড়ান্ত যাচাই / Dry-run'}).click();await commit.getByText(/নিরাপত্তার জন্য ইমপোর্ট বন্ধ আছে/).waitFor();assert(await commit.getByRole('button',{name:'নিশ্চিত করে ইমপোর্ট করুন'}).isDisabled());assert.equal(await CenterStudent.countDocuments({}),1);assert.equal(await CenterPayment.countDocuments({}),0);const editor=await login('content_editor'),ep=await editor.newPage();await ep.goto(origin+'/bn/admin/students/import',{waitUntil:'domcontentloaded',timeout:180000});assert(!ep.url().includes('/admin/students/import'));assert.deepEqual(errors,[]);await editor.close();await c.close();console.log('Browser preview, possible match, local draft and decisions, default-off write gate, role restriction, no writes and responsive screens passed.')}finally{await browser.close();await mongoose.disconnect();await mongo.stop()}}
run().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)});
