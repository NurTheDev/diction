# ─────────────────────────────────────────────────────────────────────────────
# Diction Coaching Center — environment template
#
# Copy to .env.local for local work (it is git-ignored) and paste the same
# values into Vercel → Project Settings → Environment Variables for Production
# and Preview separately, with a different database and different secrets for
# each. The staging walkthrough that uses this file, start to finish, is
# docs/DEPLOYMENT.md.
#
# Never prefix a secret with NEXT_PUBLIC_, never commit a filled-in copy, and
# never paste a real value into an issue or a chat message.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required before the site will start ──────────────────────────────────────

# MongoDB Atlas SRV connection string. Put the database name in the path and
# URL-encode every special character in the password (@ becomes %40, and so on).
# The app selects `dictioncoaching` itself, or `dictioncoaching_test` when
# CENTER_DATA_MODE=test. Atlas Network Access needs 0.0.0.0/0 because Vercel
# functions leave from dynamic addresses (docs/DEPLOYMENT.md §1).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/dictioncoaching?retryWrites=true&w=majority

# Session signing secret, at least 32 characters: openssl rand -base64 32
# Rotating it signs every existing session out.
NEXTAUTH_SECRET=

# The exact public origin of this deployment — no path, no trailing slash.
# Sitemap and Open Graph metadata are built from it.
NEXTAUTH_URL=http://localhost:3000
# Auth.js v5 reads AUTH_URL: set it to the same origin as NEXTAUTH_URL.
# A mismatch fails startup validation.
AUTH_URL=http://localhost:3000

# Bearer secret for the two scheduled jobs in vercel.json
# (/api/admin/jobs/daily and /api/admin/jobs/sms-flush). Must be 32 characters
# or more or both answer 401 and do nothing. Vercel sends
# `Authorization: Bearer $CRON_SECRET` on every cron call by itself.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# `production` for a real deployment. `test` switches to the separate
# dictioncoaching_test database and paints a test-mode banner on every page —
# never leave that on for a site people look at.
CENTER_DATA_MODE=production

# ── SMS (BulkSMSBD) ──────────────────────────────────────────────────────────
# SMS_PROVIDER=mock sends nothing and records "Sent (mock)"; bulksmsbd calls the
# real gateway. Credentials are server-only: never logged, never returned, never
# sent to a browser. CENTER_SMS_WRITE_ENABLED must also be true before any real
# HTTP call leaves the app. Turn IP whitelisting OFF in the BulkSMSBD dashboard:
# Vercel has no fixed egress IP (docs/DEPLOYMENT.md §5).
SMS_PROVIDER=mock
CENTER_SMS_WRITE_ENABLED=false
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# ── Optional integrations (all off until configured and reviewed) ────────────

# Cloudinary: the media library. Uploads and deletions are worth a manual check
# before you rely on them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend: password-reset and notification email. Best-effort — not queued, not
# guaranteed. RESEND_FROM_EMAIL must be a verified sender on the account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Gemini is the default AI provider; AI_API_KEY is accepted as an alternative
# name for the same key. AI_API_BASE_URL is an HTTPS OpenAI-compatible base and
# only needs setting when you deliberately use another provider. The key is
# server-only: never expose it in client code.
GEMINI_API_KEY=
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=gemini-3.8-flash

# YouTube Data API v3 key for automatic public-channel uploads (separate from
# the Gemini key).
YOUTUBE_DATA_API_KEY=

# ── Feature gates: every one of these ships OFF ──────────────────────────────
# Each is a decision a person makes in writing, after the review named beside
# it. Turning one on can spend money, publish a child's data or write financial
# rows, so none of them is a default.

# Intake and study writes are refused while this is false.
DATA_COLLECTION_ENABLED=false
# Enable only after HTTPS, a verified sender and account-email ownership exist.
PASSWORD_RESET_ENABLED=false
# Achievement workflow needs both this and DATA_COLLECTION_ENABLED to be true.
# Enable only after privacy/safeguarding/retention, consent and infrastructure
# reviews.
ACHIEVEMENTS_ENABLED=false
# Student Study Buddy. Enable only after provider, guardian-consent, privacy,
# safety and cost reviews.
AI_STUDY_BUDDY_ENABLED=false
# Public AI is gated separately. Enable only after child-safety, privacy, abuse
# and cost controls are approved.
PUBLIC_AI_ENABLED=false
# Experimental identity links only; no financial migration. Off until reviewed.
CENTER_LEGACY_LINK_ENABLED=false
# Experimental immutable Center due snapshots. Off until reconciliation and
# review.
CENTER_DUE_SNAPSHOT_WRITE_ENABLED=false
# Experimental Center exam creation, marks and publishing. Off pending
# acceptance testing (results are R5 work).
CENTER_EXAM_WRITE_ENABLED=false

# ── Seed only: not needed on the deployed site ───────────────────────────────
# Used by `node --env-file=.env.local --import tsx scripts/seed.ts` to create the
# first super-admin. The password is 12–72 bytes and is never printed. Do not
# store these in Vercel after the seed has run.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Test harness only: never set these on Vercel ─────────────────────────────
# VERIFY_STRICT=1        makes `npm run verify` fail on any NOT TESTED row (CI sets it)
# DICTION_TEST_BUILD=1   relaxes the build for the disposable test-mode app
# TEST_MODE_PORT=3111    port the test-mode app serves on
# INTEGRATION_TEST_ROOT  turbopack root for the integration suites
# PREVIEW_WITHOUT_SERVICES=1  local design preview with no credentials; disabled in production
# SMS_MOCK_BALANCE       balance the mock provider reports
# MONGOMS_DOWNLOAD_IGNORE_MISSING_HEADER  mongodb-memory-server download workaround
