MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/dictioncoaching?retryWrites=true&w=majority
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Set AUTH_URL to the same public origin as NEXTAUTH_URL.
AUTH_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
# Gemini key is server-only. Never expose it in client code or commit .env.local.
GEMINI_API_KEY=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
DATA_COLLECTION_ENABLED=false
# The default endpoint is Google Gemini OpenAI compatibility; override only if intentionally using another compatible provider.
AI_API_BASE_URL=
AI_MODEL=gemini-3.8-flash
# Enable only after provider, guardian-consent, privacy, safety and cost reviews.
AI_STUDY_BUDDY_ENABLED=false

# Enable only after HTTPS, verified sender and account-email ownership are in place.
PASSWORD_RESET_ENABLED=false
# Optional YouTube Data API v3 key for automatic public-channel uploads (separate from Gemini).
YOUTUBE_DATA_API_KEY=
# Achievement workflow is off unless both this and DATA_COLLECTION_ENABLED are true.
# Enable only after privacy/safeguarding/retention, consent and infrastructure reviews.
ACHIEVEMENTS_ENABLED=false
# Public AI is separately gated. Enable only after child-safety, privacy, abuse and cost controls are approved.
PUBLIC_AI_ENABLED=false



# Experimental low-level BulkSMSBD adapter only; no sending queue/UI is implemented.
CENTER_SMS_WRITE_ENABLED=false
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
# Experimental identity links only; no financial migration. Off until reviewed.
CENTER_LEGACY_LINK_ENABLED=false
# Experimental immutable Center due snapshots. Off until reconciliation and review.
CENTER_DUE_SNAPSHOT_WRITE_ENABLED=false
# Experimental Center exam creation/marks/publishing, disabled pending acceptance testing.
CENTER_EXAM_WRITE_ENABLED=false

# Set to test to use the separate dictioncoaching_test database and show a test-mode banner.
CENTER_DATA_MODE=production

# Daily housekeeping job (Recycle Bin purge + log trim). Generate with: openssl rand -base64 32
CRON_SECRET=
